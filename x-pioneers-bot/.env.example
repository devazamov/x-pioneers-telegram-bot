# ===================================================
# X PIONEERS | Official Telegram Bot Configuration
# ===================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or bot tokens to Git.

# Telegram Bot Token from @BotFather (Required)
# Example: 1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Authorized Admin Telegram Numeric IDs (Required for admin features)
# NOTE: Use numeric IDs, NOT usernames! Get yours by messaging @userinfobot or @raw_data_bot.
FOUNDER_ID=123456789
ASSISTANT_ADMIN_ID=987654321

# Optional extra admin IDs (comma-separated integers)
# EXTRA_ADMIN_IDS=111222333,444555666

# Official Telegram Channel URL (Optional)
# If left blank, the bot will display "Channel link coming soon".
# Example: https://t.me/xpioneers_official
CHANNEL_URL=

# SQLite Database filename (stored in project folder)
DATABASE_FILE=xpioneers.db

# Logging level (INFO, DEBUG, WARNING)
LOG_LEVEL=INFO
